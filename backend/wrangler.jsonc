{
  "name": "frenchapp-learning-progress",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "vars": {
    "ALLOWED_ORIGINS": "https://recovrsportsinc.github.io,http://127.0.0.1:5500,http://localhost:5500"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frenchapp-learning-progress",
      "database_id": "94ad4437-5ef7-489e-91ff-aa4bca133488"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026101701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
